# ============================================================
# LA Core — configuração Apache (Hostinger)
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---- HTTPS obrigatório e domínio sem "www" ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html → /  (evita conteúdo duplicado)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# ---- Arquivos internos: nunca públicos, mesmo que sejam enviados por engano ----
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(fotos|\.git)(/|$)
</IfModule>
<FilesMatch "^\.|\.(md|bak|log|sql|env|sh)$">
  Require all denied
</FilesMatch>

# ---- Compressão ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ---- Cache ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS e JS não têm versão no nome do arquivo: 1 semana para as atualizações chegarem logo
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---- Cabeçalhos de segurança ----
# CSP (o que cada parte libera):
#   script-src / style-src 'self'  → só arquivos do próprio site (sem scripts/estilos inline)
#   font-src 'self'                → fontes hospedadas em /assets/fonts
#   img-src 'self' data:           → imagens do site + a seta do <select> (data: URI no CSS)
#   frame-src https://www.google.com → mapa do Google (só carrega depois do clique)
#   connect-src 'self'             → o formulário envia para /api/contato.php
# Se um dia ativar Google Analytics/Tag Manager, será preciso liberar os domínios deles em
# script-src e connect-src (e pedir consentimento: ver política de privacidade).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # HSTS: 1 ano. Só acrescente "includeSubDomains; preload" se TODOS os subdomínios tiverem HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; frame-src https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# ---- Tipos de arquivo ----
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType font/woff2 .woff2
AddType text/plain .txt
AddDefaultCharset utf-8
AddCharset utf-8 .txt .xml .css .js .webmanifest
